PORT=5001
NODE_ENV=development

# MongoDB Atlas URI
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/yash_cloth_stores?retryWrites=true&w=majority

# JWT Authentication
JWT_SECRET=your_jwt_secret_here
JWT_EXPIRES_IN=7d

# Initial Admin User
ADMIN_EMAIL=admin@yashclothstores.com
ADMIN_PASSWORD=your_secure_admin_password

# Cloudinary
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Production URL Bridge (Set CLIENT_URL on Backend, VITE_API_URL on Frontend if deployed separately)
CLIENT_URL=https://your-frontend.vercel.app
VITE_API_URL=https://your-backend.onrender.com
